// =============================================================================
// F1 2026 Car Intelligence — Prisma Schema
// Part 2a: Core tables fully wired — all enums, FKs, source_provenance,
//          car_field_status, driver_team_stints.
// Single canonical file. Part 2b extends this with the remaining 9 tables.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// =============================================================================
// ENUMS — all 15 locked values defined here in full.
// Enums used only in Part 2b/2c tables are defined now to prevent piecemeal
// additions and to ensure Part 2b validates without enum changes.
// =============================================================================

// Sessions within a race weekend. round_aggregate = rolled-up record
// calculated after the race; canonical for non-Weekend views.
enum SessionType {
  fp1
  fp2
  fp3
  qualifying
  sprint_qualifying
  sprint
  race
  round_aggregate
}

// Race weekend lifecycle.
enum RoundStatus {
  upcoming
  in_progress
  completed
}

// What triggered the last round status transition.
// data = first session data arrived; time_based = 90-min fallback; manual = admin.
enum RoundStatusSource {
  data
  time_based
  manual
}

// Data layer classification applied to every sourced data point.
// official   = FIA regulations or Formula1.com results pages
// derived    = calculated from official session data
// predicted  = model or editorial estimate (probabilistic)
// unavailable = field has no publicly confirmed source
enum SourceType {
  official
  derived
  predicted
  unavailable
}

// Confirmed gearbox orientation. unavailable = not publicly disclosed.
enum GearboxType {
  longitudinal
  transverse
  unavailable
}

// Spec field availability per car. confirmed = sourced value exists.
// unavailable = field checked, no official source found, renders as
// "Not publicly confirmed" — no badge, no speculation.
enum FieldAvailability {
  confirmed
  unavailable
}

// Tyre compound — used in session_results (Part 2b).
enum TyreCompound {
  soft
  medium
  hard
  intermediate
  wet
}

// Origin of a prediction record.
// hybrid = model baseline + editor-applied delta (both fields stored).
enum PredictionSourceType {
  model
  editorial
  hybrid
}

// Confidence rating on all predicted outputs.
// low    = pre-season only / no 2026 race data for this car+circuit combo
// medium = 1-2 sessions or circuit-similarity inference
// high   = 3+ sessions of 2026 data for this car+circuit combo
enum ConfidenceLevel {
  low
  medium
  high
}

// What a prediction record is modeling.
enum PredictionType {
  fastest_lap
  strategy
  track_fit
  aero_effectiveness
}

// Admin review queue item categories.
enum AdminQueueType {
  stale_provenance
  hybrid_prediction_review
  dab_zone_correction
  round_aggregate_amendment
  iqr_threshold_update
}

// Admin review queue item lifecycle.
enum AdminQueueStatus {
  pending
  in_review
  resolved
  dismissed
}

// Live DAB zone record lifecycle.
// under_correction = confidence cascade to LOW is active for this circuit.
enum DabZoneStatus {
  confirmed
  under_correction
}

// Circuit-level prediction threshold source.
// Transitions from static_default to iqr_derived after admin confirms
// IQR calculation with 4+ circuit data points.
enum ThresholdSource {
  static_default
  iqr_derived
}

// DAB zone staging record lifecycle.
enum StagingPromotionStatus {
  pending
  promoted
  rejected
}

// =============================================================================
// TABLES — Part 2a: 9 tables
// Reverse relations on each table are limited to models defined in this part.
// Part 2b will add the remaining 9 models and extend these relations.
// =============================================================================

// -----------------------------------------------------------------------------
// TABLE 1: source_provenance
// Leaf table — zero outbound FKs. Never deleted (permanent audit trail).
// All sourced data tables carry a non-nullable provenance_id FK to this table.
// stale_threshold_hours: default 24h; overridable per record at ingestion time.
//   Recommended defaults: race=24h, qualifying=12h, practice=6h, FIA docs=168h.
// content_hash: MD5 of parsed page content. Mismatch triggers stale_since + is_stale.
// -----------------------------------------------------------------------------
model SourceProvenance {
  id                    String     @id @default(cuid())
  source_type           SourceType
  url                   String?
  document_reference    String?
  accessed_at           DateTime
  content_hash          String?
  stale_since           DateTime?
  stale_threshold_hours Int        @default(24)
  is_stale              Boolean    @default(false)
  created_at            DateTime   @default(now())

  // Reverse relations — Part 2a models only.
  // Part 2b will extend with: circuit_profiles, circuit_dab_zones,
  // session_results, fastest_laps, car_circuit_perf, predictions.
  cars_specs       Car[]            @relation("CarSpecsProvenance")
  car_field_status CarFieldStatus[]

  @@map("source_provenance")
}

// -----------------------------------------------------------------------------
// TABLE 2: teams
// Direct Team→Driver relation removed — team membership now in driver_team_stints.
// Team→Car relation retained (Car.team_id is stable; cars don't change teams).
// -----------------------------------------------------------------------------
model Team {
  id              String    @id @default(cuid())
  slug            String    @unique
  name            String
  short_name      String
  power_unit      String
  color_primary   String
  color_secondary String?
  created_at      DateTime  @default(now())
  deleted_at      DateTime?

  cars   Car[]
  stints DriverTeamStint[]

  @@map("teams")
}

// -----------------------------------------------------------------------------
// TABLE 3: drivers
// team_id dropped — team membership now tracked via driver_team_stints.
// -----------------------------------------------------------------------------
model Driver {
  id           String    @id @default(cuid())
  first_name   String
  last_name    String
  abbreviation String    @unique
  number       Int       @unique
  nationality  String
  created_at   DateTime  @default(now())
  deleted_at   DateTime?

  team_stints DriverTeamStint[]

  @@map("drivers")
}

// -----------------------------------------------------------------------------
// TABLE 4: cars
// unavailable_fields JSON blob dropped — now in car_field_status (Table 16).
// specs_provenance_id is non-nullable: every car record must cite a source.
// -----------------------------------------------------------------------------
model Car {
  id                  String           @id @default(cuid())
  team_id             String
  team                Team             @relation(fields: [team_id], references: [id], onDelete: Restrict)
  season              Int
  designation         String
  gearbox_type        GearboxType      @default(unavailable)
  weight_kg           Float?
  fuel_capacity_l     Float?
  suspension_concept  String?
  notes               String?
  specs_provenance_id String
  specs_provenance    SourceProvenance @relation("CarSpecsProvenance", fields: [specs_provenance_id], references: [id], onDelete: Restrict)
  created_at          DateTime         @default(now())
  deleted_at          DateTime?

  field_status CarFieldStatus[]

  @@map("cars")
}

// -----------------------------------------------------------------------------
// TABLE 5: circuits
// -----------------------------------------------------------------------------
model Circuit {
  id              String    @id @default(cuid())
  slug            String    @unique
  name            String
  short_name      String
  country         String
  city            String
  lap_length_km   Float
  total_laps_race Int
  created_at      DateTime  @default(now())
  deleted_at      DateTime?

  rounds Round[]

  @@map("circuits")
}

// -----------------------------------------------------------------------------
// TABLE 6: rounds
// scheduled_start and scheduled_race dropped — all schedule times live on Session.
// Round holds calendar identity and status only.
// @@unique([season, round_number]) prevents duplicate round numbers per season.
// -----------------------------------------------------------------------------
model Round {
  id                  String            @id @default(cuid())
  circuit_id          String
  circuit             Circuit           @relation(fields: [circuit_id], references: [id], onDelete: Restrict)
  season              Int
  round_number        Int
  name                String
  status              RoundStatus       @default(upcoming)
  status_source       RoundStatusSource @default(data)
  dab_zones_confirmed Boolean           @default(false)
  created_at          DateTime          @default(now())
  deleted_at          DateTime?

  sessions Session[]

  @@unique([season, round_number])
  @@map("rounds")
}

// -----------------------------------------------------------------------------
// TABLE 7: sessions
// All schedule times live here — Round no longer stores scheduled_start/race.
// attempt_number: 1 for original; increments on reschedule within same round.
// rescheduled_from_id: self-ref FK to the cancelled session this replaces.
// Partial unique index is a raw SQL migration (not a Prisma constraint):
//   UNIQUE (round_id, session_type, attempt_number) WHERE session_cancelled = 0
//   See prisma/migrations/manual/001_session_partial_unique.sql
// -----------------------------------------------------------------------------
model Session {
  id                  String      @id @default(cuid())
  round_id            String
  round               Round       @relation(fields: [round_id], references: [id], onDelete: Restrict)
  session_type        SessionType
  attempt_number      Int         @default(1)
  scheduled_start     DateTime
  actual_start        DateTime?
  ended_at            DateTime?
  session_cancelled   Boolean     @default(false)
  cancellation_reason String?
  rescheduled_from_id String?
  rescheduled_from    Session?    @relation("SessionReschedule", fields: [rescheduled_from_id], references: [id])
  reschedules         Session[]   @relation("SessionReschedule")
  results_url         String?
  created_at          DateTime    @default(now())
  deleted_at          DateTime?

  @@map("sessions")
}

// -----------------------------------------------------------------------------
// TABLE 16: car_field_status
// Replaces Car.unavailable_fields JSON blob.
// One row per spec field per car. Enables cross-car field availability queries:
//   WHERE field_name = 'weight_kg' AND status = 'confirmed'
// @@unique([car_id, field_name]) enforces one status per field per car.
// provenance_id: non-nullable — every status row must cite a source
//   (confirmed = cite the document; unavailable = cite the check that found nothing).
// -----------------------------------------------------------------------------
model CarFieldStatus {
  id            String            @id @default(cuid())
  car_id        String
  car           Car               @relation(fields: [car_id], references: [id], onDelete: Restrict)
  field_name    String
  status        FieldAvailability
  provenance_id String
  provenance    SourceProvenance  @relation(fields: [provenance_id], references: [id], onDelete: Restrict)
  created_at    DateTime          @default(now())

  @@unique([car_id, field_name])
  @@map("car_field_status")
}

// -----------------------------------------------------------------------------
// TABLE 17: driver_team_stints
// Replaces Driver.team_id.
// from_round: round_number of first session_result with this team (data-anchored).
// to_round: null = active stint. Closed atomically when new stint opens.
// @@unique([driver_id, season, from_round]) prevents duplicate stint starts.
// Overlapping to_round values prevented by application-layer transaction only
//   (SQLite/Prisma do not support range exclusion constraints).
// Mid-weekend replacements: both drivers may share the same round number.
//   session_results is authoritative for within-round team attribution.
// -----------------------------------------------------------------------------
model DriverTeamStint {
  id         String   @id @default(cuid())
  driver_id  String
  driver     Driver   @relation(fields: [driver_id], references: [id], onDelete: Restrict)
  team_id    String
  team       Team     @relation(fields: [team_id], references: [id], onDelete: Restrict)
  season     Int
  from_round Int
  to_round   Int?
  created_at DateTime @default(now())

  @@unique([driver_id, season, from_round])
  @@map("driver_team_stints")
}
