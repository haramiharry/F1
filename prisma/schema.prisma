// =============================================================================
// F1 2026 Car Intelligence — Prisma Schema
// Database: SQLite (development) → PostgreSQL (production)
// All enums defined in consolidated block before table definitions.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// =============================================================================
// ENUMS (consolidated — all enums defined here, not inline per model)
// SQLite: stored as strings. PostgreSQL migration: convert to native enum types.
// =============================================================================

/// Individual session classifications within a race weekend.
/// round_aggregate = rolled-up record calculated after the race completes.
enum SessionType {
  fp1
  fp2
  fp3
  qualifying
  sprint_qualifying
  sprint
  race
  round_aggregate
}

/// Lifecycle state of a race weekend round.
enum RoundStatus {
  upcoming
  in_progress
  completed
}

/// What triggered the round status transition.
/// data = first session data arrived; time_based = fallback timer; manual = admin override.
enum RoundStatusSource {
  data
  time_based
  manual
}

/// Data layer classification — applied to every data point in the app.
enum SourceType {
  official // Direct from FIA regulations or Formula1.com results pages
  derived // Calculated from official session data
  predicted // Model or editorial estimate — probabilistic
  unavailable // Field has no publicly confirmed source
}

/// Origin of a prediction record.
enum PredictionSourceType {
  model // Generated by the analytics model
  editorial // Manually authored by a domain expert
  hybrid // Model baseline + editor-applied delta (see original_model_output + editorial_delta)
}

/// Confidence rating attached to all predicted outputs.
/// low    = pre-season only / no 2026 race data for this combo
/// medium = 1-2 sessions or circuit-similarity inference
/// high   = 3+ sessions of 2026 data for this car/circuit combo
enum ConfidenceLevel {
  low
  medium
  high
}

/// What a prediction record is modeling.
enum PredictionType {
  fastest_lap // Predicted fastest lap time (ms) for a car at a circuit
  strategy // Per-car strategy recommendation for a circuit
  track_fit // 0-10 fit score for a car at a circuit
  aero_effectiveness // 0-10 X-mode or Z-mode advantage score
}

/// Admin review queue item categories.
enum AdminQueueType {
  stale_provenance // Source page content hash changed, awaiting diff review
  hybrid_prediction_review // Model recalculated; editor must accept / adjust / hold
  dab_zone_correction // Confirmed DAB zone found to be wrong; under correction
  round_aggregate_amendment // Post-race penalty revised a round aggregate record
  iqr_threshold_update // IQR-derived threshold ready to replace static default
}

/// Lifecycle state of an admin review queue item.
enum AdminQueueStatus {
  pending
  in_review
  resolved
  dismissed
}

/// Confirmed gearbox orientation. Unavailable = not publicly disclosed.
enum GearboxType {
  longitudinal
  transverse
  unavailable
}

/// Lifecycle state of a DAB zone record.
/// under_correction = live record is being corrected; confidence cascade active.
enum DabZoneStatus {
  confirmed
  under_correction
}

// =============================================================================
// TABLES
// Dependency order: leaf tables first, then parents, then children.
// =============================================================================

// -----------------------------------------------------------------------------
// TABLE 1: source_provenance
// LEAF TABLE — has no outbound foreign keys.
// All other tables that contain sourced data reference this table.
// stale_threshold_hours defaults by session type:
//   race=24h, qualifying=12h, practice=6h, FIA docs=168h. Overridable per record.
// -----------------------------------------------------------------------------
model SourceProvenance {
  id                    String     @id @default(cuid())
  source_type           SourceType
  url                   String? // Canonical page URL
  document_reference    String? // e.g. "2026 Sporting Regs Art. 39.4"
  accessed_at           DateTime // When data was read from this source
  content_hash          String? // MD5 of parsed page content at ingestion
  stale_since           DateTime? // Set when content_hash mismatch detected
  stale_threshold_hours Int        @default(24) // Hours before stale_since triggers UI warning
  is_stale              Boolean    @default(false)
  created_at            DateTime   @default(now())

  // Reverse relations — every table that FKs to source_provenance is listed here
  cars_specs        Car[]                   @relation("CarSpecsProvenance")
  circuit_profiles  CircuitProfile[]
  circuit_dab_zones CircuitDabZone[]
  session_results   SessionResult[]
  fastest_laps      FastestLap[]
  car_circuit_perf  CarCircuitPerformance[]
  predictions       Prediction[]

  @@map("source_provenance")
}

// -----------------------------------------------------------------------------
// TABLE 2: teams
// Parent of: drivers, cars
// -----------------------------------------------------------------------------
model Team {
  id              String    @id @default(cuid())
  slug            String    @unique // "red-bull-racing" — used in URLs and CSS
  name            String // "Red Bull Racing"
  short_name      String // "Red Bull" — used in chart labels
  power_unit      String // "Honda RBPT"
  color_primary   String // "#1E41FF" — team accent for UI
  color_secondary String? // Optional secondary accent
  created_at      DateTime  @default(now())
  deleted_at      DateTime?

  drivers Driver[]
  cars    Car[]

  @@map("teams")
}

// -----------------------------------------------------------------------------
// TABLE 3: drivers
// Parent of: session_results, fastest_laps, predictions
// Child of: teams
// -----------------------------------------------------------------------------
model Driver {
  id           String    @id @default(cuid())
  team_id      String
  team         Team      @relation(fields: [team_id], references: [id], onDelete: Restrict)
  first_name   String
  last_name    String
  abbreviation String    @unique // "VER" — three-letter FIA code
  number       Int       @unique // Race number
  nationality  String
  created_at   DateTime  @default(now())
  deleted_at   DateTime?

  session_results SessionResult[]
  fastest_laps    FastestLap[]
  predictions     Prediction[]

  @@map("drivers")
}

// -----------------------------------------------------------------------------
// TABLE 4: cars
// Parent of: car_circuit_performance, predictions
// Child of: teams, source_provenance
// unavailable_fields: JSON array of field names with no public source.
//   These render as "Not publicly confirmed" in the UI — no badge, no speculation.
//   e.g. '["weight_kg","fuel_capacity_l","suspension_concept"]'
// specs_provenance_id is non-nullable: every car record must cite a source.
// -----------------------------------------------------------------------------
model Car {
  id                  String           @id @default(cuid())
  team_id             String
  team                Team             @relation(fields: [team_id], references: [id], onDelete: Restrict)
  season              Int // 2026
  designation         String // "RB21"
  gearbox_type        GearboxType      @default(unavailable)
  weight_kg           Float? // null = unavailable
  fuel_capacity_l     Float? // null = unavailable
  suspension_concept  String? // null = unavailable
  unavailable_fields  String? // JSON array of unconfirmed field names
  notes               String?
  specs_provenance_id String
  specs_provenance    SourceProvenance @relation("CarSpecsProvenance", fields: [specs_provenance_id], references: [id], onDelete: Restrict)
  created_at          DateTime         @default(now())
  deleted_at          DateTime?

  circuit_performance CarCircuitPerformance[]
  predictions         Prediction[]

  @@map("cars")
}

// -----------------------------------------------------------------------------
// TABLE 5: circuits
// Parent of: circuit_profiles, circuit_dab_zones, circuit_dab_zones_staging,
//            rounds, car_circuit_performance, predictions
// -----------------------------------------------------------------------------
model Circuit {
  id              String    @id @default(cuid())
  slug            String    @unique // "monza", "silverstone", "monaco"
  name            String // "Autodromo Nazionale Monza"
  short_name      String // "Monza"
  country         String
  city            String
  lap_length_km   Float
  total_laps_race Int
  created_at      DateTime  @default(now())
  deleted_at      DateTime?

  profile             CircuitProfile?
  dab_zones           CircuitDabZone[]
  dab_zones_staging   CircuitDabZoneStaging[]
  rounds              Round[]
  circuit_performance CarCircuitPerformance[]
  predictions         Prediction[]

  @@map("circuits")
}

// -----------------------------------------------------------------------------
// TABLE 6: circuit_profiles
// One-to-one with circuits. Static scoring characteristics + prediction thresholds.
// prediction_review_threshold_s: triggers "Under review" chip on hybrid predictions
//   when model delta exceeds this value.
//   Defaults: street circuits ~0.3s, power circuits ~0.6s, balanced ~0.45s.
//   Auto-transitions to IQR-derived value once data_points_for_threshold >= 4
//   and admin confirms via the review queue.
// Child of: circuits, source_provenance
// -----------------------------------------------------------------------------
model CircuitProfile {
  id                            String           @id @default(cuid())
  circuit_id                    String           @unique
  circuit                       Circuit          @relation(fields: [circuit_id], references: [id], onDelete: Restrict)
  drag_sensitivity              Float // 0-10
  traction_demand               Float // 0-10
  braking_intensity             Float // 0-10
  overtaking_potential          Float // 0-10
  aero_zone_value               Float // 0-10: how much DAB zone timing matters here
  baseline_fastest_lap_s        Float // Reference lap time for threshold calculations
  prediction_review_threshold_s Float // Circuit-specific hybrid review threshold (seconds)
  // "static_default" until 4+ data points exist; "iqr_derived" after admin confirms
  threshold_source              String           @default("static_default")
  pending_threshold_update      Float? // Candidate IQR value awaiting admin review
  data_points_for_threshold     Int              @default(0)
  provenance_id                 String
  provenance                    SourceProvenance @relation(fields: [provenance_id], references: [id], onDelete: Restrict)
  updated_at                    DateTime         @updatedAt
  deleted_at                    DateTime?

  @@map("circuit_profiles")
}

// -----------------------------------------------------------------------------
// TABLE 7: circuit_dab_zones (live)
// FIA-defined Drag Activation Zone boundaries per circuit per round.
// Source: FIA Event Notes, published ~48-72h before first session.
// Must be promoted from circuit_dab_zones_staging via explicit admin confirmation.
// Corrections: set status=under_correction, write correction to staging, re-promote.
//   During under_correction: all depends_on_dab_zones records for this circuit
//   have confidence force-downgraded to LOW.
// Amendments use superseded_at chain — no hard deletes.
// Child of: circuits, rounds, source_provenance
// Self-referencing for correction/amendment history chain.
// -----------------------------------------------------------------------------
model CircuitDabZone {
  id                   String           @id @default(cuid())
  circuit_id           String
  circuit              Circuit          @relation(fields: [circuit_id], references: [id], onDelete: Restrict)
  round_id             String
  round                Round            @relation(fields: [round_id], references: [id], onDelete: Restrict)
  zone_number          Int // 1, 2, 3... per FIA Event Notes
  start_reference      String // Marshal sector or distance reference
  end_reference        String
  activation_direction String // "pit_straight", "back_straight", etc.
  status               DabZoneStatus    @default(confirmed)
  amendment_reason     String?
  superseded_at        DateTime?
  superseded_by_id     String?
  superseded_by        CircuitDabZone?  @relation("DabZoneSupersession", fields: [superseded_by_id], references: [id])
  supersedes           CircuitDabZone[] @relation("DabZoneSupersession")
  provenance_id        String
  provenance           SourceProvenance @relation(fields: [provenance_id], references: [id], onDelete: Restrict)
  created_at           DateTime         @default(now())
  // No deleted_at — corrections use superseded_at chain

  @@map("circuit_dab_zones")
}

// -----------------------------------------------------------------------------
// TABLE 8: circuit_dab_zones_staging
// Receives parser output from the admin DAB zone ingestion endpoint.
// Parser output always lands here. Promotion to circuit_dab_zones requires
// explicit admin sign-off after reviewing the zone SVG overlay in the admin UI.
// parse_errors: JSON array of parser warnings e.g. ["zone_3_boundary_ambiguous"]
// Child of: circuits, rounds
// -----------------------------------------------------------------------------
model CircuitDabZoneStaging {
  id                   String    @id @default(cuid())
  circuit_id           String
  circuit              Circuit   @relation(fields: [circuit_id], references: [id], onDelete: Restrict)
  round_id             String
  round                Round     @relation(fields: [round_id], references: [id], onDelete: Restrict)
  zone_number          Int
  start_reference      String
  end_reference        String
  activation_direction String
  parse_errors         String? // JSON array of parser warnings
  submitted_at         DateTime  @default(now())
  reviewed_at          DateTime?
  reviewer_notes       String?
  promoted_at          DateTime?
  promotion_status     String    @default("pending") // "pending" | "promoted" | "rejected"

  @@map("circuit_dab_zones_staging")
}

// -----------------------------------------------------------------------------
// TABLE 9: rounds
// A race weekend event in the 2026 calendar.
// Status transitions:
//   upcoming → in_progress: first session data arrives (data),
//                           OR 90min after scheduled start with no data (time_based),
//                           OR admin override (manual)
//   in_progress → completed: race result ingested + round_aggregate calculated ONLY
//                            (no time-based completion — race end time is variable)
// Soft delete: BLOCKED (Restrict) if dependent sessions or car_circuit_performance exist.
// Child of: circuits
// Parent of: sessions, circuit_dab_zones, circuit_dab_zones_staging,
//            car_circuit_performance, fastest_laps, predictions
// -----------------------------------------------------------------------------
model Round {
  id                  String            @id @default(cuid())
  circuit_id          String
  circuit             Circuit           @relation(fields: [circuit_id], references: [id], onDelete: Restrict)
  season              Int // 2026
  round_number        Int // 1 = Australia, 2 = China, etc.
  name                String // "Australian Grand Prix"
  status              RoundStatus       @default(upcoming)
  status_source       RoundStatusSource @default(data)
  dab_zones_confirmed Boolean           @default(false) // True after admin confirms FIA Event Notes
  scheduled_start     DateTime // First session (FP1 or SQ) scheduled start
  scheduled_race      DateTime // Race session scheduled start
  created_at          DateTime          @default(now())
  deleted_at          DateTime?

  sessions            Session[]
  dab_zones           CircuitDabZone[]
  dab_zones_staging   CircuitDabZoneStaging[]
  circuit_performance CarCircuitPerformance[]
  fastest_laps        FastestLap[]
  predictions         Prediction[]

  @@unique([season, round_number])
  @@map("rounds")
}

// -----------------------------------------------------------------------------
// TABLE 10: sessions
// An individual session within a round (FP1, FP2, FP3, Q, SQ, Sprint, Race).
// Rescheduled sessions: cancelled session keeps attempt_number=1 with
//   session_cancelled=true. Replacement gets attempt_number=2, rescheduled_from_id set.
// DATABASE-LEVEL UNIQUENESS enforced by partial unique index (not Prisma constraint):
//   CREATE UNIQUE INDEX idx_session_active_unique
//   ON sessions (round_id, session_type, attempt_number)
//   WHERE session_cancelled = 0;
//   (see prisma/migrations/manual/001_session_partial_unique.sql)
// Application layer sets attempt_number by querying MAX before insert.
// Child of: rounds
// Parent of: session_results, fastest_laps
// Self-referencing for reschedule chain.
// -----------------------------------------------------------------------------
model Session {
  id                  String      @id @default(cuid())
  round_id            String
  round               Round       @relation(fields: [round_id], references: [id], onDelete: Restrict)
  session_type        SessionType
  attempt_number      Int         @default(1)
  scheduled_start     DateTime
  actual_start        DateTime?
  ended_at            DateTime?
  session_cancelled   Boolean     @default(false)
  cancellation_reason String?
  rescheduled_from_id String? // FK to the session this replaces
  rescheduled_from    Session?    @relation("SessionReschedule", fields: [rescheduled_from_id], references: [id])
  reschedules         Session[]   @relation("SessionReschedule")
  results_url         String? // Official Formula1.com results page URL
  created_at          DateTime    @default(now())
  deleted_at          DateTime?

  results      SessionResult[]
  fastest_laps FastestLap[]

  @@map("sessions")
}

// -----------------------------------------------------------------------------
// TABLE 11: session_results
// Individual driver classification for one session.
// lap_time_ms: milliseconds to avoid floating-point precision issues.
//   e.g. 1:22.091 = 82091ms
// Unique per (session_id, driver_id) — one row per driver per session.
// Child of: sessions, drivers, source_provenance
// -----------------------------------------------------------------------------
model SessionResult {
  id               String           @id @default(cuid())
  session_id       String
  session          Session          @relation(fields: [session_id], references: [id], onDelete: Restrict)
  driver_id        String
  driver           Driver           @relation(fields: [driver_id], references: [id], onDelete: Restrict)
  position         Int? // null = DNF / DSQ / DNS
  classified       Boolean          @default(true)
  lap_time_ms      Int? // Best lap in milliseconds
  gap_to_leader_ms Int?
  laps_completed   Int?
  tyre_compound    String? // "soft"|"medium"|"hard"|"intermediate"|"wet"
  provenance_id    String
  provenance       SourceProvenance @relation(fields: [provenance_id], references: [id], onDelete: Restrict)
  created_at       DateTime         @default(now())
  deleted_at       DateTime?

  @@unique([session_id, driver_id])
  @@map("session_results")
}

// -----------------------------------------------------------------------------
// TABLE 12: fastest_laps
// Official fastest lap records. Tracks the DHL Fastest Lap Award.
// Seed anchors: VER 1:22.091 (82091ms) Round 1 Australia [Official — Formula1.com]
//               ANT 1:35.275 (95275ms) Round 2 China     [Official — Formula1.com]
// round_id is denormalized (derivable via session.round_id) for direct query perf.
// Amendments use superseded_at chain — no hard deletes.
// Self-referencing for amendment history.
// Child of: rounds, sessions, drivers, source_provenance
// -----------------------------------------------------------------------------
model FastestLap {
  id               String           @id @default(cuid())
  round_id         String // Denormalized for direct queries
  round            Round            @relation(fields: [round_id], references: [id], onDelete: Restrict)
  session_id       String
  session          Session          @relation(fields: [session_id], references: [id], onDelete: Restrict)
  driver_id        String
  driver           Driver           @relation(fields: [driver_id], references: [id], onDelete: Restrict)
  lap_time_ms      Int // 82091 for 1:22.091
  lap_time_display String // "1:22.091"
  award_eligible   Boolean          @default(true) // DHL Fastest Lap Award eligibility
  superseded_at    DateTime?
  amendment_reason String?
  superseded_by_id String?
  superseded_by    FastestLap?      @relation("FastestLapAmendment", fields: [superseded_by_id], references: [id])
  supersedes       FastestLap[]     @relation("FastestLapAmendment")
  provenance_id    String
  provenance       SourceProvenance @relation(fields: [provenance_id], references: [id], onDelete: Restrict)
  created_at       DateTime         @default(now())
  // No deleted_at — amendments use superseded_at chain

  @@map("fastest_laps")
}

// -----------------------------------------------------------------------------
// TABLE 13: car_circuit_performance
// Derived performance metrics per car per circuit per round per session.
// Composite unique key: (car_id, circuit_id, round_id, session_type)
// session_type=round_aggregate: canonical rolled-up record for non-Weekend views.
//   Calculated automatically after race result ingested.
//   "Current view" query: WHERE session_type='round_aggregate' AND round_id=MAX(round_id)
//   "asOfRound" query: WHERE session_type='round_aggregate' AND round_id=?
// depends_on_dab_zones: when true, a DAB zone correction sets recalculation_required=true
//   and confidence cascades to LOW until job completes.
// Confidence cascade also applies to: Prediction records with depends_on_dab_zones=true
//   for the same circuit. (strategy recs, fastest_lap predictions, aero_effectiveness)
// Child of: cars, circuits, rounds, source_provenance
// -----------------------------------------------------------------------------
model CarCircuitPerformance {
  id           String      @id @default(cuid())
  car_id       String
  car          Car         @relation(fields: [car_id], references: [id], onDelete: Restrict)
  circuit_id   String
  circuit      Circuit     @relation(fields: [circuit_id], references: [id], onDelete: Restrict)
  round_id     String
  round        Round       @relation(fields: [round_id], references: [id], onDelete: Restrict)
  session_type SessionType

  // Performance dimension scores 0-10 (source_type=derived)
  one_lap_pace             Float?
  long_run_pace            Float?
  straight_line_efficiency Float?
  cornering_performance    Float?
  tyre_behaviour           Float?

  // Active-aero effectiveness 0-10 (source_type=derived)
  x_mode_effectiveness Float? // Benefit from Straight Mode (X Mode)
  z_mode_effectiveness Float? // Benefit from Corner Mode (Z Mode)

  depends_on_dab_zones   Boolean @default(false) // Set at write time
  recalculation_required Boolean @default(false) // Set when DAB zone correction active

  provenance_id String
  provenance    SourceProvenance @relation(fields: [provenance_id], references: [id], onDelete: Restrict)
  calculated_at DateTime         @default(now())
  deleted_at    DateTime?

  @@unique([car_id, circuit_id, round_id, session_type])
  @@map("car_circuit_performance")
}

// -----------------------------------------------------------------------------
// TABLE 14: predictions
// All predictive outputs: fastest lap estimates, strategy recs, track fit, aero scores.
// source_type=editorial: pre-season baselines, round_valid_from=0.
//   Superseded_at set when Round 1 model output is first generated for same combo.
//   Editorial record archived for Methodology page provenance chain.
// source_type=hybrid: original_model_output + editorial_delta both stored.
//   When model recalculates, editorial_review_required=true is set.
//   Editor must decide within 48h: accept / new hybrid / hold.
//   If 48h passes without decision: model output displays with LOW confidence + chip.
//   Exception: if delta > circuit prediction_review_threshold_s → "Under review" chip
//   displays immediately without waiting for 48h window.
// asOfRound=0 API: returns WHERE round_valid_from=0 AND superseded_at IS NULL
// Self-referencing for revision history.
// Child of: cars (optional), drivers (optional), circuits, rounds (optional), source_provenance
// -----------------------------------------------------------------------------
model Prediction {
  id              String         @id @default(cuid())
  prediction_type PredictionType

  car_id           String?
  car              Car?    @relation(fields: [car_id], references: [id], onDelete: Restrict)
  driver_id        String?
  driver           Driver? @relation(fields: [driver_id], references: [id], onDelete: Restrict)
  circuit_id       String
  circuit          Circuit @relation(fields: [circuit_id], references: [id], onDelete: Restrict)
  round_id         String?
  round            Round?  @relation(fields: [round_id], references: [id], onDelete: Restrict)
  round_valid_from Int     @default(0) // 0 = pre-season baseline

  predicted_value         Float? // Lap time ms OR 0-10 score depending on type
  predicted_value_display String? // "1:21.400" or "7.4 / 10"
  margin_of_error_ms      Float? // +/- margin for fastest_lap predictions
  confidence              ConfidenceLevel @default(low)

  source_type           PredictionSourceType @default(model)
  original_model_output Float? // Preserved when source_type=hybrid
  editorial_delta       Float? // Editor adjustment applied to model output
  editorial_rationale   String? // Editor's written justification

  superseded_at    DateTime?
  superseded_by_id String?
  superseded_by    Prediction?  @relation("PredictionSupersession", fields: [superseded_by_id], references: [id])
  supersedes       Prediction[] @relation("PredictionSupersession")
  amendment_reason String?

  editorial_review_required Boolean @default(false) // Model recalculated; editor must decide
  model_recalc_pending      Boolean @default(false) // New model output waiting in queue
  depends_on_dab_zones      Boolean @default(false) // Set at write time
  recalculation_required    Boolean @default(false) // Set when DAB zone correction active

  provenance_id String
  provenance    SourceProvenance @relation(fields: [provenance_id], references: [id], onDelete: Restrict)
  created_at    DateTime         @default(now())

  @@map("predictions")
}

// -----------------------------------------------------------------------------
// TABLE 15: admin_review_queue
// Unified inbox for all review-required items across the system.
// Polymorphic association: entity_id references records in multiple tables.
//   No DB-level FK constraint by design. entity_type matches @@map name of target.
// Priority formula (computed at query time, not stored):
//   score = staleness_score + confidence_impact_score + visibility_score
//   Weekend multiplier (×1.5 to ×4.0 based on time to next session — applied at query time)
//   The stored priority field is the seed score without the weekend multiplier.
// -----------------------------------------------------------------------------
model AdminReviewQueue {
  id               String           @id @default(cuid())
  queue_type       AdminQueueType
  entity_type      String // @@map name of affected table e.g. "predictions"
  entity_id        String // ID of affected record — no DB FK (polymorphic)
  priority         Int              @default(0) // Seed score; multiplied at query time
  status           AdminQueueStatus @default(pending)
  assigned_to      String?
  created_at       DateTime         @default(now())
  resolved_at      DateTime?
  resolution_notes String?

  @@map("admin_review_queue")
}
