# =============================================================================
# F1 2026 Car Intelligence — Environment Variables
# Copy this file to .env and fill in values before running.
# =============================================================================

# ---------------------------------------------------------------------------
# DATABASE
# ---------------------------------------------------------------------------

# Development (SQLite — no server required)
DATABASE_URL="file:./prisma/dev.db"

# Production (PostgreSQL — replace with your connection string)
# DATABASE_URL="postgresql://user:password@host:5432/f1_intelligence?schema=public"

# ---------------------------------------------------------------------------
# CRON AUTHENTICATION
# Used by GET /api/ingestion/cron/round-status to prevent unauthenticated
# invocation in production. Generate a random secret (e.g. openssl rand -hex 32).
# When set, the cron caller must include: Authorization: Bearer <value>
# On Vercel, the platform handles cron auth automatically — set this for
# external schedulers (Railway cron, GitHub Actions, etc.).
# Leave unset in development: the auth check is skipped when CRON_SECRET is unset.
# ---------------------------------------------------------------------------
CRON_SECRET=""

# ---------------------------------------------------------------------------
# NODE ENVIRONMENT (set by platform — do not override manually in production)
# ---------------------------------------------------------------------------
# NODE_ENV="production"
